{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "${CLOUDFLARE_WORKER_NAME}",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "${OAUTH_KV_NAMESPACE_ID}" },
    { "binding": "PROFILE_KV", "id": "${PROFILE_KV_NAMESPACE_ID}" }
  ],
  "ratelimits": [
    { "name": "ASSESSMENT_RATE_LIMITER", "namespace_id": "${ASSESSMENT_RATE_LIMIT_NAMESPACE_ID}", "simple": { "limit": 5, "period": 60 } }
  ]
}
